# === OBLIGATOIRE ===

# Comptes créés au premier démarrage (choisir des mots de passe forts)
DEVISEUR_EMAIL=deviseur@maji.fr
DEVISEUR_PASSWORD=CHANGER_MOT_DE_PASSE_DEVISEUR
DEVISEUR_NAME=Prénom Nom
DIRECTEUR_EMAIL=directeur@maji.fr
DIRECTEUR_PASSWORD=CHANGER_MOT_DE_PASSE_DIRECTEUR
DIRECTEUR_NAME=Prénom Nom


# Votre nom de domaine (ex: devis.maji.fr)
DOMAIN=devis.maji.fr

# Mot de passe PostgreSQL — choisir une chaîne aléatoire longue
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# URL de connexion à la base (remplacer CHANGER_CE_MOT_DE_PASSE par la même valeur que DB_PASSWORD)
DATABASE_URL=postgresql://maji:CHANGER_CE_MOT_DE_PASSE@db:5432/maji

# Secret JWT — générer avec : python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=GENERER_UNE_VALEUR_ALEATOIRE_64_CHARS

# Environnement (désactive Swagger /docs et /redoc)
APP_ENV=production

# Origines CORS autorisées (votre domaine avec https)
CORS_ORIGINS=https://devis.maji.fr

# === IA (optionnel) ===
# Laisser sk-ant-dummy pour le mode mock (sans appel API réel)
ANTHROPIC_API_KEY=sk-ant-dummy

# === SMTP — requis pour l'envoi de devis par email ===
# Exemple Gmail : utiliser un "App Password" (pas le mot de passe principal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@gmail.com
SMTP_PASSWORD=votre_app_password
SMTP_FROM=devis@maji.fr
SMTP_TLS=true
