# Copier ce fichier en .env et remplir les valeurs

# Clé API Anthropic — https://console.anthropic.com/
# Laisser sk-ant-dummy pour utiliser le mode mock IA (sans appel API)
ANTHROPIC_API_KEY=sk-ant-dummy

JWT_SECRET=change_this_in_production_to_something_random_and_long

# Comptes créés au premier démarrage
DEVISEUR_EMAIL=deviseur@maji.fr
DEVISEUR_PASSWORD=deviseur123
DEVISEUR_NAME=Deviseur
DIRECTEUR_EMAIL=directeur@maji.fr
DIRECTEUR_PASSWORD=directeur123
DIRECTEUR_NAME=Directeur

# SMTP — requis pour l'envoi de devis par email
# Exemple Gmail : SMTP_HOST=smtp.gmail.com / PORT=587 / utiliser un "App Password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=devis@maji.fr
SMTP_TLS=true
